{
  "name": "Kotogram",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "deploy": "npm run generate && wrangler deploy",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:core": "node --experimental-strip-types --test tests/game-core.test.mjs",
    "test:language": "node --experimental-strip-types --test tests/language.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:stage": "node --experimental-strip-types --test tests/stage-validator.test.mjs",
    "validate:stages": "node --experimental-strip-types scripts/validate-stages.mjs",
    "dev:api": "wrangler dev --config wrangler.api.jsonc",
    "deploy:api": "npm run preflight:production && wrangler deploy --config wrangler.api.jsonc --env production",
    "deploy:api:dev": "wrangler deploy --config wrangler.api.jsonc",
    "explore:stages": "node --experimental-strip-types scripts/explore-stages.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions app/game/core.ts app/game/visuals.ts app/game/character.ts app/game/renderer.ts app/language/parser.ts app/scoring/score.ts app/stage/validator.ts app/stage/progression.ts app/stage/explorer.ts app/editor/text-input.ts app/ranking/client.ts",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:visual": "node .browser-tools/node_modules/@playwright/test/cli.js test --config playwright.config.mjs",
    "preflight:production": "node scripts/preflight-production.mjs"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/icon": "^2.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "eslint": "^9.38.0",
    "nuxt": "^4.1.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
