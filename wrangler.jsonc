{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kotogram",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "kotogram.sae-chan.net",
      "custom_domain": true
    }
  ]
}
